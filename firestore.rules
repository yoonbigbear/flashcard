rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 데이터는 계정별로 users/{uid}/... 에 따로 저장된다.
    //  - 소유자(users/{OWNER_UID}): 누구나 읽기 가능(게스트 읽기 전용), 쓰기는 소유자만
    //  - 그 밖의 계정: 본인 경로만 읽고 쓸 수 있다
    function isOwnerPath(uid) {
      return uid == 'BZ9tnw3zjtc7Jh75G1SBOBR8ckM2';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 링크 공유: 공유 id 를 아는 사람만 한 건씩 읽을 수 있고(목록 조회 불가), 만들기는 로그인한 사람만 가능하다.
    match /shares/{id} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['d', 'owner', 'created'])
        && request.resource.data.d is string
        && request.resource.data.d.size() < 300000
        && request.resource.data.owner == request.auth.uid;
    }

    match /users/{uid}/{document=**} {
      allow read: if isOwnerPath(uid) || isSelf(uid);
      allow write: if isSelf(uid);
    }
  }
}
